rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if request is from the owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper to check if user is admin
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'aplut0006@gmail.com';
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Song requests collection
    match /songRequests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // For liking requests & updating status when notation added
      allow delete: if isAdmin() || (isSignedIn() && (
        (resource.data.keys().hasAll(['userId']) && resource.data.userId == request.auth.uid) ||
        (resource.data.keys().hasAll(['userEmail']) && request.auth.token.keys().hasAll(['email']) && resource.data.userEmail.lower() == request.auth.token.email.lower())
      ));

      // Submitted notations subcollection
      match /notations/{notationId} {
        allow read: if true;
        allow create: if true;
        allow update: if true; // For liking individual submitted notations
        allow delete: if isAdmin() || (isSignedIn() && (
          (resource.data.keys().hasAll(['authorId']) && resource.data.authorId == request.auth.uid) ||
          (resource.data.keys().hasAll(['authorEmail']) && request.auth.token.keys().hasAll(['email']) && resource.data.authorEmail.lower() == request.auth.token.email.lower())
        ));
      }
    }

    // Direct messages
    match /direct_messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn(); // For liking posts
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }
  }
}
